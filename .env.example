# ===============================================
# CONFIGURATION COMMUNE (DEVELOPPEMENT + PRODUCTION)
# ===============================================

# Cles secretes (generez des valeurs securisees pour la production)
# Utilisez: openssl rand -hex 32
NEXTAUTH_SECRET=your-nextauth-secret-here
HASH_SECRET=your-hash-secret-here
JWT_SECRET=your-jwt-secret-here
JWT_SIGNING_PRIVATE_KEY=your-jwt-signing-key-here
JWT_ENCRYPTION_KEY=your-jwt-encryption-key-here

# Configuration de l'URL de l'application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Configuration des sessions
SESSION_MAX_AGE=604800
SESSION_UPDATE_AGE=86400

# Configuration du taux de limitation
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX_REQUESTS=100

# Metadonnees de l'application
NEXT_PUBLIC_APP_NAME=kut.es
NEXT_PUBLIC_APP_DESCRIPTION=Un service de raccourcissement d URL simple et efficace

# Configuration SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="kut.es <your-email@gmail.com>"
EMAIL_FROM="kut.es <your-email@gmail.com>"

# IP geolocation token
IPINFO_TOKEN=your-ipinfo-token

# ===============================================
# ENVIRONNEMENT DE DEVELOPPEMENT
# ===============================================

NODE_ENV=development
NEXT_PUBLIC_APP_ENV=development

# Base de donnees PostgreSQL
DATABASE_URL="postgresql://postgres:password@localhost:5432/kut.es?schema=public&connection_limit=20&pool_timeout=10"
DB_PASSWORD=your-db-password

# URLs de developpement
NEXTAUTH_URL=http://localhost:3200
NEXTAUTH_URL_INTERNAL=http://localhost:3200
NEXT_PUBLIC_BASE_URL=http://localhost:3200

# Configuration cookies developpement
NEXTAUTH_COOKIE_DOMAIN=localhost
NEXTAUTH_COOKIE_SECURE=false

# Desactiver la verification d'email en developpement
NEXT_PUBLIC_DISABLE_EMAIL_VERIFICATION=true

# ===============================================
# ENVIRONNEMENT DE PRODUCTION (A ACTIVER)
# ===============================================

# NODE_ENV=production
# NEXT_PUBLIC_APP_ENV=production
# DATABASE_URL="postgresql://user:password@db:5432/kutes_prod?schema=public&connection_limit=20&pool_timeout=10"
# NEXTAUTH_URL=https://kut.es
# NEXTAUTH_URL_INTERNAL=https://kut.es
# NEXT_PUBLIC_BASE_URL=https://kut.es
# NEXTAUTH_COOKIE_DOMAIN=kut.es
# NEXTAUTH_COOKIE_SECURE=true
# NEXTAUTH_COOKIE_PATH=/
# NEXTAUTH_COOKIE_HTTPONLY=true
# NEXTAUTH_COOKIE_SAME_SITE=lax
# NEXT_PUBLIC_DISABLE_EMAIL_VERIFICATION=false

# ===============================================
# CONFIGURATION OPTIONNELLE
# ===============================================

# OAuth
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GITHUB_ID=your-github-id
# GITHUB_SECRET=your-github-secret

# Cache Redis
# REDIS_URL=redis://localhost:6379

# Analytics Google
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Mode maintenance
# MAINTENANCE_MODE=false
# MAINTENANCE_MESSAGE=Le site est actuellement en maintenance.

# ===============================================
# CONFIGURATION S3P SMOBILPAY
# ===============================================

S3P_BASE_URL=https://s3p.smobilpay.staging.maviance.info/v2
S3P_ACCESS_TOKEN=your-s3p-access-token
S3P_ACCESS_SECRET=your-s3p-access-secret
S3P_SERVICE_ID=1
S3P_SIMULATION_MODE=false
S3P_LOG_LEVEL=info

# Webhook S3P (optionnel)
S3P_WEBHOOK_URL=https://yourdomain.com/api/webhooks/s3p
S3P_WEBHOOK_SECRET=your-webhook-secret

# ===============================================
# CONFIGURATION E-NKAP
# ===============================================

ENKAP_CONSUMER_KEY=your-enkap-consumer-key
ENKAP_CONSUMER_SECRET=your-enkap-consumer-secret
ENKAP_TOKEN_URL=https://api.enkap-staging.maviance.info/token
ENKAP_API_BASE_URL=https://api.enkap-staging.maviance.info/purchase/v1.2/api

# URLs de retour E-nkap
ENKAP_RETURN_URL=${NEXTAUTH_URL}/payment/callback
ENKAP_NOTIFY_URL=${NEXTAUTH_URL}/api/v1/payment/enkap/notify
ENKAP_CANCEL_URL=${NEXTAUTH_URL}/dashboard/upgrade?status=cancelled
